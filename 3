
#include <stdio.h>
#include <stdbool.h>

// Funkcja obliczajaca BMI
double calculateBMI(double weight, double height) {
    height = height / 100.0; // zamiana cm na metry
    return weight / (height * height);
}

// Funkcja obliczajaca WHR
double calculateWHR(double waist, double hips) {
    return waist / hips;
}

int main() {
    double weight, height;
    double waist, hips;
    double bmi, whr;
    int choice;
    char again;

    do {
        printf("\n===== KALKULATOR BMI I WHR =====\n");
        printf("1. Oblicz BMI\n");
        printf("2. Oblicz WHR\n");
        printf("3. Oblicz BMI dla 3 osob\n");
        printf("Wybierz opcje: ");

        if (scanf("%d", &choice) != 1) {
            printf("Blad! Wprowadz prawidlowa liczbe.\n");
            while (getchar() != '\n');
            continue;
        }

        switch (choice) {

            case 1:
                printf("Podaj wage (kg): ");
                if (scanf("%lf", &weight) != 1 || weight <= 0) {
                    printf("Blad! Waga musi byc dodatnia.\n");
                    while (getchar() != '\n');
                    break;
                }

                printf("Podaj wzrost (cm): ");
                if (scanf("%lf", &height) != 1 || height <= 0) {
                    printf("Blad! Wzrost musi byc dodatni.\n");
                    while (getchar() != '\n');
                    break;
                }

                bmi = calculateBMI(weight, height);
                printf("Twoje BMI = %.2f\n", bmi);
                break;

            case 2:
                printf("Podaj obwod talii (cm): ");
                if (scanf("%lf", &waist) != 1 || waist <= 0) {
                    printf("Blad! Obwod talii musi byc dodatni.\n");
                    while (getchar() != '\n');
                    break;
                }

                printf("Podaj obwod bioder (cm): ");
                if (scanf("%lf", &hips) != 1 || hips <= 0) {
                    printf("Blad! Obwod bioder musi byc dodatni.\n");
                    while (getchar() != '\n');
                    break;
                }

                whr = calculateWHR(waist, hips);
                printf("Twoj wskaznik WHR = %.2f\n", whr);
                break;

            case 3:
                printf("\nObliczanie BMI dla 3 osob:\n");

                for (int i = 1; i <= 3; i++) {
                    printf("\nOsoba %d\n", i);

                    printf("Podaj wage (kg): ");
                    if (scanf("%lf", &weight) != 1 || weight <= 0) {
                        printf("Blad! Nieprawidlowa waga.\n");
                        while (getchar() != '\n');
                        i--;
                        continue;
                    }

                    printf("Podaj wzrost (cm): ");
                    if (scanf("%lf", &height) != 1 || height <= 0) {
                        printf("Blad! Nieprawidlowy wzrost.\n");
                        while (getchar() != '\n');
                        i--;
                        continue;
                    }

                    bmi = calculateBMI(weight, height);
                    printf("BMI osoby %d = %.2f\n", i, bmi);
                }
                break;

            default:
                printf("Nieprawidlowy wybor! Wybierz opcje 1, 2 lub 3.\n");
                break;
        }

        printf("\nCzy chcesz wykonac kolejne obliczenie? (t/n): ");
        scanf(" %c", &again);

    } while (again == 't' || again == 'T');

    printf("\nKoniec programu. Dziekujemy!\n");

    return 0;
}
